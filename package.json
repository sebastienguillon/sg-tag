{
  "name": "sg-tag",
  "productName": "SG Tag",
  "version": "0.1.0",
  "description": "Tag and retrieve local images and videos, fast.",
  "author": "Sébastien Guillon",
  "license": "UNLICENSED",
  "homepage": "https://github.com/sebastienguillon/sg-tags",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebastienguillon/sg-tags.git"
  },
  "bugs": {
    "url": "https://github.com/sebastienguillon/sg-tags/issues"
  },
  "private": true,
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=24.11",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "ng": "ng",
    "dev": "node scripts/dev.ts",
    "build": "ng build && node scripts/build-electron.ts",
    "start": "pnpm build && electron .",
    "package": "pnpm build && electron-builder --publish never",
    "package:dir": "pnpm build && electron-builder --dir",
    "lint": "eslint --max-warnings 0 .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit",
    "test": "pnpm test:renderer && pnpm test:electron",
    "test:renderer": "ng test --watch=false",
    "test:electron": "node scripts/electron-node.ts node_modules/vitest/vitest.mjs run"
  },
  "dependencies": {
    "@parcel/watcher": "^2.6.0",
    "better-sqlite3": "^13.0.3",
    "fdir": "^6.5.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cdk": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/common": "^22.2.2",
    "@angular/compiler": "^22.2.2",
    "@angular/compiler-cli": "^22.2.2",
    "@angular/core": "^22.2.2",
    "@angular/forms": "^22.2.2",
    "@angular/platform-browser": "^22.2.2",
    "@angular/router": "^22.2.2",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "angular-eslint": "^22.5.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.1.2",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.9",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
